# Copy this to ~/.jarvis/.env (or alongside main.py) and chmod 600.
#
# JARVIS auto-detects backend on startup (in priority order):
#   - if CLAUDE_CODE_OAUTH_TOKEN is set → Claude Pro via Agent SDK (primary)
#   - else if OPENROUTER_API_KEY is set → OpenRouter
#   - else if JARVIS_OLLAMA_MODEL / JARVIS_OLLAMA_URL is set → Ollama (fully offline)
#   - on Claude failure, falls back to OpenRouter if available

# ─── Primary: Claude Pro subscription ──────────────────────────────────
# Get this token by running:
#   npm install -g @anthropic-ai/claude-code
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Optional model override (defaults to claude-sonnet-4-6)
# Available: claude-haiku-4-5, claude-sonnet-4-6, claude-opus-4-7
# JARVIS_CLAUDE_MODEL=claude-sonnet-4-6

# ─── Fallback: OpenRouter ──────────────────────────────────────────────
# Free models available, e.g. openai/gpt-oss-120b:free
# OPENROUTER_API_KEY=sk-or-...
# JARVIS_MODEL=openai/gpt-oss-120b:free

# ─── Offline: Ollama ───────────────────────────────────────────────────
# Run a fully-local model with no internet/subscription. Install Ollama
# (https://ollama.com), then `ollama pull llama3.1` (or any tool-capable model
# such as qwen2.5, mistral). Set the model to activate this backend:
# JARVIS_OLLAMA_MODEL=llama3.1
# JARVIS_OLLAMA_URL=http://localhost:11434

# ─── Force a specific backend (auto | claude | openrouter | ollama) ────
# JARVIS_LLM_BACKEND=auto

# ─── IMPORTANT: leave this UNSET to use OAuth/Pro ──────────────────────
# If ANTHROPIC_API_KEY is set, it shadows the OAuth token and bills
# against your API account (not your Pro plan).
# unset ANTHROPIC_API_KEY

# ─── Optional voice / search backends ──────────────────────────────────
# JARVIS_WHISPER_MODEL=base.en
# JARVIS_PIPER_BIN=piper
# SEARX_URL=http://localhost:8080
# BRAVE_API_KEY=
