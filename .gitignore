# ── Python ────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
pip-wheel-metadata/

# Built React/Vite frontend output is committed so the app works out of the box.
!jarvis/static/dist/
!jarvis/static/dist/**

# ── Secrets & environment ──────────────────────────────────────────────────
.env
*.env
!.env.example
*.pem
*.key

# ── Runtime / data ─────────────────────────────────────────────────────────
# JARVIS stores all runtime data outside the repo in ~/.jarvis/
# Never commit history, memory, or audio cache.
*.pyc
*.wav
*.mp3
*.pcm

# ── Claude Code settings ───────────────────────────────────────────────────
.claude/settings.local.json

# ── Personal system prompt (keep your own version here, outside the repo) ──
jarvis/personal info jarvis/

# ── IDE & editor ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# ── openwakeword model cache ────────────────────────────────────────────────
openwakeword/
*.tflite
*.onnx
*.onnx.json

# ── faster-whisper / CTranslate2 model cache ───────────────────────────────
# (downloaded to ~/.cache/huggingface automatically)
models/
*.bin
*.safetensors

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# Cloned reference repo (not part of JARVIS)
OpenJarvis/
addons.txt

# ── WhatsApp bridge (vendored from lharries/whatsapp-mcp) ───────────────────
# Built binaries (run.sh / run.ps1 build these on first run) and runtime data
# (session DB, message history, downloaded media, QR code) never get committed.
whatsapp-mcp/whatsapp-bridge/whatsapp-bridge
whatsapp-mcp/whatsapp-bridge/whatsapp-bridge.exe
whatsapp-mcp/whatsapp-bridge/qr.png
whatsapp-mcp/whatsapp-bridge/store/
